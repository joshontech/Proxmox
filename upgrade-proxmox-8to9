#!/bin/bash
set -euo pipefail

##############################################
# Functions
##############################################

error_exit() {
    echo "ERROR: $1"
    exit 1
}

confirm() {
    while true; do
        read -rp "$1 (y/n) " answer
        case "$answer" in
            [Yy]* ) return 0 ;;
            [Nn]* ) echo "Exiting..."; exit 0 ;;
            * ) echo "Please answer y or n." ;;
        esac
    done
}

##############################################
# Step 1: Pre‑flight check
##############################################

echo "Running Proxmox 8→9 pre‑flight check..."
pve8to9 --full

confirm "Continue with upgrade"

##############################################
# Step 2: Update system before switching repos
##############################################

echo "Updating package lists..."
apt update

echo "Running dist-upgrade..."
apt dist-upgrade -y

##############################################
# Step 3: Determine current and target Debian versions
##############################################

# Extract current codename from first deb entry
if ! grep -q "^deb " /etc/apt/sources.list; then
    error_exit "No deb entries found in /etc/apt/sources.list"
fi

old_repo=$(grep "^deb " /etc/apt/sources.list | head -n1 | awk '{print $3}')
echo "Detected current Debian codename: $old_repo"

# Fetch Debian stable codename
codename=$(curl -s https://deb.debian.org/debian/dists/stable/Release \
    | awk '/^Codename:/ {print $2}')

if [[ -z "$codename" ]]; then
    error_exit "Unable to fetch Debian stable codename"
fi

echo "Current Debian stable codename: $codename"

if [[ "$old_repo" == "$codename" ]]; then
    echo "System is already on the latest Debian release."
    exit 0
fi

new_repo="$codename"
echo "Upgrading Debian codename: $old_repo → $new_repo"

##############################################
# Step 4: Update repository files
##############################################

update_repo_file() {
    local file="$1"
    if [[ -f "$file" ]]; then
        sed -i "s/$old_repo/$new_repo/g" "$file"
        echo "Updated $file"
    else
        echo "Skipping missing file: $file"
    fi
}

update_repo_file /etc/apt/sources.list
update_repo_file /etc/apt/sources.list.d/pve-enterprise.list
update_repo_file /etc/apt/sources.list.d/pve-no-subscription.list

##############################################
# Step 5: Verify changes
##############################################

verify_repo_file() {
    local file="$1"
    if [[ -f "$file" ]] && ! grep -q "$new_repo" "$file"; then
        error_exit "Failed to update $file with new codename"
    fi
}

verify_repo_file /etc/apt/sources.list
verify_repo_file /etc/apt/sources.list.d/pve-enterprise.list
verify_repo_file /etc/apt/sources.list.d/pve-no-subscription.list

echo "Repository files updated successfully."

##############################################
# Step 6: Final upgrade
##############################################

echo "Running final apt update..."
apt update

echo "Running final dist-upgrade..."
apt dist-upgrade -y

echo "Upgrade completed. A reboot is recommended."
